DB_URL=jdbc:postgresql://localhost:5433/school_saas
# Rôle applicatif restreint (non superutilisateur) — utilisé par le backend au runtime.
DB_USER=school_saas
DB_PASSWORD=school_saas
# Rôle superutilisateur, utilisé UNIQUEMENT par Flyway pour les migrations (DDL).
# Voir docs/ARCHITECTURE.md ADR-001 : Row-Level Security est toujours contourné pour un
# superutilisateur PostgreSQL, donc jamais utilisé pour les requêtes applicatives.
DB_ADMIN_USER=school_saas_admin
DB_ADMIN_PASSWORD=school_saas_admin
JWT_SECRET=change-me
REDIS_URL=redis://localhost:6379
# Origine(s) autorisées à appeler l'API depuis un navigateur (CORS), séparées par une virgule
# si plusieurs — uniquement nécessaire en dev/staging (Web sur une origine différente du
# backend, ex. `ng serve`). Pas nécessaire en production (Nginx, même domaine).
CORS_ALLOWED_ORIGINS=http://localhost:4200
STRIPE_SECRET_KEY=
# Secret de vérification de signature du endpoint webhook (dashboard Stripe > Webhooks),
# différent de STRIPE_SECRET_KEY.
STRIPE_WEBHOOK_SECRET=
# URLs de redirection après Stripe Checkout (voir com.schoolsaas.billing.BillingCheckoutService).
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:4200/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:4200/billing/cancel
# Cycle de vie de l'abonnement (cahier-des-charges.md §4.2) — valeurs par défaut si absentes :
# essai de 30 jours, plan ESSENTIEL, 3 jours de grâce après échec de paiement puis 7 jours en
# lecture seule avant suspension (voir docs/ARCHITECTURE.md ADR-009).
BILLING_TRIAL_DAYS=30
BILLING_DEFAULT_TRIAL_PLAN_CODE=ESSENTIEL
BILLING_PAST_DUE_GRACE_DAYS=3
BILLING_READ_ONLY_GRACE_DAYS=7
FCM_CREDENTIALS_PATH=
