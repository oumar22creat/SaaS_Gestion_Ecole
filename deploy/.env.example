# Copier en deploy/.env sur le serveur, puis remplir. Ce fichier ne doit jamais être versionné.
#
# Générer chaque secret avec :  openssl rand -base64 36

# ----------------------------------------------------------------------------- Domaine
# Sans sous-domaine ni protocole. Les établissements vivront sur <ecole>.DOMAIN.
DOMAIN=exemple.com
# Adresse recevant les avis d'expiration Let's Encrypt.
LETSENCRYPT_EMAIL=contact@exemple.com

# ---------------------------------------------------------------------------- Base de données
DB_NAME=school_saas
# Rôle superutilisateur : migrations Flyway uniquement.
DB_ADMIN_USER=school_saas_admin
DB_ADMIN_PASSWORD=
# Rôle applicatif restreint : c'est lui qui subit les politiques Row-Level Security.
# Il NE DOIT PAS être superutilisateur, sans quoi l'isolation entre établissements tombe.
DB_USER=school_saas
DB_PASSWORD=

# ------------------------------------------------------------------------------- Sécurité
# Au moins 32 octets. Le changer déconnecte tout le monde : ce n'est pas anodin.
JWT_SECRET=

# ------------------------------------------------------------------------ SMS (facultatif)
SMS_ENABLED=false
SMS_PROVIDER=
SMS_URL=
SMS_AUTH_HEADER=
SMS_AUTH_VALUE=
# Guillemets obligatoires : ce fichier est chargé par `source` dans backup.sh, et une
# valeur contenant un espace y serait interprétée comme une commande.
SMS_SENDER_NAME="School Manager"
SMS_DEFAULT_COUNTRY_CODE=223

# ---------------------------------------------------------------------------- Abonnements
# Jours de tolérance après l'échéance d'un abonnement réglé en espèces. 0 = accès fermé le
# jour dit.
BILLING_CASH_GRACE_DAYS=0

# ------------------------------------------------------------------------- Sauvegardes
# Destination hors serveur. Une sauvegarde sur le même disque que la base ne protège de rien.
#
# Backblaze B2 : l'adresse dépend de la région du seau, affichée dans la console à côté de
# son nom (« Endpoint »). Exemple : https://s3.eu-central-003.backblazeb2.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
# Clé d'application limitée à CE seau, jamais la clé maîtresse : celle-ci permettrait de
# détruire l'ensemble du compte, y compris les sauvegardes qu'elle est censée protéger.
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Phrase de chiffrement des archives : elles contiennent les dossiers scolaires d'enfants.
BACKUP_PASSPHRASE=
# Jours de rétention sur le serveur et à distance.
BACKUP_RETENTION_DAYS=30
