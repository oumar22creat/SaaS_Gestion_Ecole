# Sert les deux fronts statiques : le site vitrine sur le domaine principal, l'application
# Angular sur les sous-domaines d'établissement. Un seul conteneur, un seul certificat.

FROM node:22-alpine AS build
WORKDIR /build

COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime

# Application (sous-domaines) et site vitrine (domaine principal).
COPY --from=build /build/dist/web/browser /usr/share/nginx/html/app
COPY landing/ /usr/share/nginx/html/site/

COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/ssl-params.conf deploy/nginx/proxy-params.conf /etc/nginx/
# L'image officielle substitue les variables des fichiers *.template au démarrage et dépose
# le résultat dans conf.d/ : c'est ainsi que ${DOMAIN} devient le vrai domaine.
COPY deploy/nginx/conf.d/ /etc/nginx/templates/

EXPOSE 80 443
