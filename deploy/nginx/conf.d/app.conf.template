# Redirection HTTP → HTTPS, sauf le chemin de validation Let's Encrypt.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN} *.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------------ Site vitrine (domaine nu)
# www → domaine nu : une seule adresse canonique pour les moteurs de recherche. Le certificat
# générique *.${DOMAIN} couvre www.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/ssl-params.conf;

    return 301 https://${DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/ssl-params.conf;
    # Hérité uniquement par les locations sans add_header (redirections) ; les autres
    # l'incluent elles-mêmes, voir site-headers.conf.
    include /etc/nginx/site-headers.conf;

    root /usr/share/nginx/html/site;

    # Page 404 du site au lieu de celle de Nginx, pour toute ressource absente.
    error_page 404 /404.html;

    # « Démarrer l'essai gratuit » et « Se connecter » pointent vers /register et /login, qui
    # sont des routes de l'application Angular, pas des pages du site vitrine. Sans ces deux
    # redirections, les deux boutons d'appel à l'action du site tombent sur un 404 de Nginx.
    #
    # Redirection ici plutôt que liens absolus dans le HTML : le nom de domaine reste écrit à
    # un seul endroit, celui qui le connaît déjà.
    location = /register {
        return 302 https://app.${DOMAIN}/register;
    }

    location = /login {
        return 302 https://app.${DOMAIN}/login;
    }

    # ------------------------------------------------------------------------ Pages HTML
    # HTML en no-cache : le navigateur revalide à chaque visite (304 si inchangé), si bien
    # qu'une page désigne toujours la version courante de site.vN.css / site.vN.js.
    #
    # Accueil servi par try_files et non par la directive index : index ferait une redirection
    # interne vers /index.html, que la location suivante renverrait en 301 vers / (boucle).
    location = / {
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/site-headers.conf;
    }

    location = /index.html {
        return 301 /$is_args$args;
    }

    # /index servirait l'accueil (try_files $uri.html) : doublon de /.
    location = /index {
        return 301 /$is_args$args;
    }

    # /404 servirait la page 404 en 200 (« soft 404 ») : on répond un vrai 404. Le corps vient
    # de error_page → /404.html, qui porte ses propres en-têtes (always).
    location = /404 {
        return 404;
    }

    # Exception : URL citée telle quelle dans les fiches App Store et Google Play.
    location = /confidentialite.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/site-headers.conf;
    }

    # Cible de error_page uniquement : demandée directement, elle répond elle aussi en 404.
    # `always` car add_header ignore sinon les réponses 404.
    location = /404.html {
        internal;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/site-headers.conf;
    }

    # URL propres : /tarifs.html → /tarifs (canoniques sans extension, voir SPEC §10.2).
    # Ne concerne que les requêtes du visiteur : try_files ci-dessous sert tarifs.html sans
    # repasser par la recherche de location, donc sans boucle.
    location ~ ^/(.+)\.html$ {
        return 301 /$1$is_args$args;
    }

    # Barre finale superflue : /tarifs/ → /tarifs (aucune page n'est un répertoire).
    location ~ ^(.+)/$ {
        return 301 $1$is_args$args;
    }

    location = /robots.txt {
        add_header Cache-Control "public, max-age=3600";
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/site-headers.conf;
    }

    location = /sitemap.xml {
        add_header Cache-Control "public, max-age=3600";
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/site-headers.conf;
    }

    # Pas de $uri/ : aucune page n'est un répertoire, et servir un répertoire sans index
    # répondrait 403 au lieu de 404.
    location / {
        try_files $uri $uri.html =404;
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/site-headers.conf;
    }

    # ---------------------------------------------------------------------- Ressources
    # Défense en profondeur : les .md sont déjà retirés de l'image (Dockerfile.web), mais un
    # fichier de notes ajouté sous landing/ ne doit jamais partir en ligne, même monté en volume.
    # Placée avant les autres regex : la première qui correspond l'emporte.
    location ~* \.md$ {
        return 404;
    }

    # Feuille de style et script versionnés par leur nom (site.v1.css → site.v2.css à chaque
    # modification) et polices (jamais modifiées sous le même nom) : cache d'un an, immutable.
    location ~ ^/assets/fonts/.+\.woff2$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/site-headers.conf;
    }

    location ~ \.v[0-9]+\.(?:css|js)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/site-headers.conf;
    }

    # Images : noms non versionnés, donc 7 jours seulement (SPEC §10.5). Renommer le fichier
    # pour imposer une nouvelle image avant ce délai.
    location ~* \.(?:avif|webp|jpe?g|png|svg|ico)$ {
        add_header Cache-Control "public, max-age=604800";
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/site-headers.conf;
    }

    # Toute autre ressource CSS/JS au nom non versionné : cache court.
    location ~* \.(?:css|js|woff2)$ {
        add_header Cache-Control "public, max-age=3600";
        include /etc/nginx/security-headers.conf;
        include /etc/nginx/site-headers.conf;
    }
}

# ------------------------------------------- Application : un sous-domaine par établissement
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name *.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/ssl-params.conf;

    root /usr/share/nginx/html/app;
    index index.html;

    # ------------------------------------------------------------------------------- API
    location /api/v1/auth/login {
        limit_req zone=auth burst=5 nodelay;
        include /etc/nginx/proxy-params.conf;
        proxy_pass http://backend:8080;
        proxy_read_timeout 30s;
    }

    location /api/ {
        include /etc/nginx/proxy-params.conf;
        proxy_pass http://backend:8080;
        # Les exports PDF d'un trimestre entier prennent parfois plusieurs dizaines de secondes.
        proxy_read_timeout 120s;
    }

    location /actuator/health {
        include /etc/nginx/proxy-params.conf;
        proxy_pass http://backend:8080;
        proxy_read_timeout 10s;
        access_log off;
    }

    # ------------------------------------------------------------------ Application Angular
    # Les fichiers générés par Angular portent une empreinte dans leur nom : ils peuvent être
    # mis en cache indéfiniment, et une nouvelle version change leur nom.
    location ~* \.(js|css|woff2|svg|png|jpg|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security-headers.conf;
    }

    # index.html jamais mis en cache : c'est lui qui désigne les fichiers ci-dessus. Servi
    # depuis un cache, il réclamerait des morceaux d'une version qui n'existe plus — c'est
    # exactement l'erreur « Failed to fetch dynamically imported module ».
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
    }
}
